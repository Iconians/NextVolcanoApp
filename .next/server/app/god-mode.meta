{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/god-mode/layout,_N_T_/god-mode/page,_N_T_/god-mode"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/god-mode/__PAGE__",
    "/god-mode",
    "/_index",
    "/_head"
  ]
}